# FastAPI Chatbot - Environment Configuration
# Copy this file to .env and adjust values as needed

# Application Settings
APP_NAME=FastAPI Chatbot
APP_VERSION=1.0.1
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8080

# API Configuration
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# Chatbot Settings
DEFAULT_LANGUAGE=en
CONFIDENCE_THRESHOLD=0.3

# Session Management
SESSION_TTL_HOURS=24
MAX_SESSIONS=1000

# CORS Settings (comma-separated list)
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST
ALLOWED_HEADERS=*

# Development Mode (set to true for auto-reload)
# UVICORN_RELOAD=true

# Optional: Custom data file path
# CHATBOT_DATA_PATH=app/infrastructure/data/datasets/chatbot-data.json
